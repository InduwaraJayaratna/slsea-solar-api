{
  "name": "slsea-solar-api",
  "version": "0.1.0",
  "description": "REST API for SLSEA real-time and historical rooftop solar generation data",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run docs:lint && node --test",
    "lint": "eslint .",
    "seed:generate": "node scripts/generate-seed.js",
    "seed:validate": "node scripts/validate-seed.js",
    "seed:mongo": "node scripts/seed-mongo.js",
    "smoke": "node scripts/smoke.js",
    "docs:lint": "node scripts/lint-openapi.js"
  },
  "author": "Induwara Jayaratna",
  "license": "UNLICENSED",
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "fresh": "^2.0.0",
    "helmet": "^8.3.0",
    "js-yaml": "^5.4.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "serverless-http": "^4.0.0",
    "swagger-ui-express": "^5.0.1"
