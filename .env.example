# Copy to .env and fill in as needed. Empty values use the defaults shown.

# development | production | test (test turns off request logging). Default: development
NODE_ENV=
# Port the server listens on. Default: 3000
PORT=
# Where repositories read data from: memory (seed JSON in data/seed/). Default: memory
DATA_SOURCE=
# Largest JSON request body accepted. Default: 100kb
BODY_LIMIT=
# Secret for signing access tokens (HS256). REQUIRED outside tests, at least 32
# characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime: seconds, or a string like 1h or 30m. Default: 1h
JWT_EXPIRES_IN=
# Origin allowed to call the API from a browser (e.g. https://dashboard.example.lk). Default: *
CORS_ORIGIN=
