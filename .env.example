# Copy to .env and fill in as needed. Empty values use the defaults shown.

# development | production | test (test turns off request logging). Default: development
NODE_ENV=
# Port the server listens on. Default: 3000
PORT=
# Where repositories read data from: memory (seed JSON in data/seed/). Default: memory
DATA_SOURCE=
# Largest JSON request body accepted. Default: 100kb
BODY_LIMIT=
